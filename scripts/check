#!/usr/bin/env bash
# Runs the checks every push needs and nothing else does: ruff, ty and the unit tests, in about ten seconds. The
# pre-push hook in .githooks runs it. CI runs the same checks again; the tests that need Docker run with `scripts/integration-tests`.
# Extra arguments go to pytest, for example `scripts/check -x`.
set -euo pipefail

cd "$(dirname "$0")/.."

uv run --locked ruff check
uv run --locked ruff format --check
uv run --locked ty check
uv run --locked pytest -n auto -q "$@"
